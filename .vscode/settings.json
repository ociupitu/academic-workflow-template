{
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-cd",                
                "-auxdir=%DIR%/aux_files",
                "%DOC%"
            ]
        }
    ]
}
